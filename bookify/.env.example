# Email verification and password reset are off until SMTP is ready.
BOOKIFY_EMAIL_ENABLED=false
# Public address of the site: used in email links and accepted as a request origin.
# Use http://localhost:5173 for local development.
BOOKIFY_PUBLIC_URL=https://mybookify.no
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@mybookify.no
SMTP_PASS=replace-with-a-google-app-password
SMTP_FROM=Bookify <noreply@mybookify.no>
